
*.tmp
*.temp
*.log

# Large data files (anno, probesets) are committed to inst/extdata/
# but NOT tracked for changes to avoid bloat on updates
# Keep the shipped annotation and probeset files available in inst/extdata/.
inst/extdata/*.rds
!inst/extdata/anno.uniq_harmonized.liftover.rds
!inst/extdata/probesets_hg19.rds

